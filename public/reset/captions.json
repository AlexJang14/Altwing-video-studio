[
  {
    "at": 0.18,
    "end": 3.0233333333333334,
    "text": "Someone in space is asking for help."
  },
  {
    "at": 3.18,
    "end": 5.208888888888886,
    "text": "It's your first rescue mission."
  },
  {
    "at": 5.208888888888886,
    "end": 7.701333333333334,
    "text": "You came to find out what happened."
  },
  {
    "at": 8.22,
    "end": 10.340799999999998,
    "text": "Luckily, you brought Wangdoo."
  },
  {
    "at": 10.340799999999998,
    "end": 13.272,
    "text": "He helps explorers find their way."
  },
  {
    "at": 15.35,
    "end": 16.72533333333333,
    "text": "The lights are on."
  },
  {
    "at": 16.72533333333333,
    "end": 18.420666666666666,
    "text": "The rooms are warm."
  },
  {
    "at": 18.420666666666666,
    "end": 20.436,
    "text": "But everyone is gone."
  },
  {
    "at": 22.18,
    "end": 23.847291666666667,
    "text": "Then you hear it."
  },
  {
    "at": 27.1,
    "end": 28.957645833333334,
    "text": "Wangdoo checks the room."
  },
  {
    "at": 28.957645833333334,
    "end": 31.455291666666668,
    "text": "His scanner finds nobody."
  },
  {
    "at": 34.0,
    "end": 35.69573333333334,
    "text": "But someone keeps knocking."
  },
  {
    "at": 35.69573333333334,
    "end": 39.03933333333333,
    "text": "And Wangdoo's scanner just stopped working."
  },
  {
    "at": 39.25,
    "end": 42.165777777777784,
    "text": "Then you check your ship's camera."
  },
  {
    "at": 42.165777777777784,
    "end": 43.15866666666667,
    "text": "Someone is inside."
  },
  {
    "at": 45.18,
    "end": 47.177,
    "text": "Your ship is about to leave."
  },
  {
    "at": 47.177,
    "end": 50.48133333333333,
    "text": "And opening that door could take too long."
  },
  {
    "at": 52.18,
    "end": 53.706041666666664,
    "text": "Do you open the door?"
  },
  {
    "at": 53.706041666666664,
    "end": 55.71329166666666,
    "text": "Or run back to your ship?"
  },
  {
    "at": 57.25,
    "end": 59.112,
    "text": "Comment A or B."
  },
  {
    "at": 60.45,
    "end": 61.96224074074074,
    "text": "Wangdoo can guide you."
  },
  {
    "at": 61.96224074074074,
    "end": 64.20129166666666,
    "text": "But the decision is yours."
  },
  {
    "at": 64.22,
    "end": 66.63914930555556,
    "text": "Engineers face problems like this."
  },
  {
    "at": 66.63914930555556,
    "end": 69.96595833333333,
    "text": "Explore how they solve them on AltWing."
  }
]
