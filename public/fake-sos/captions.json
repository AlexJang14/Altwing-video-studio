[
  {
    "at": 0.05,
    "end": 1.457875,
    "text": "You came to rescue him."
  },
  {
    "at": 1.577875,
    "end": 3.090875,
    "text": "Now he's stealing your ship."
  },
  {
    "at": 4.65,
    "end": 7.326583,
    "text": "A missing astronaut. One call for help."
  },
  {
    "at": 7.506583,
    "end": 9.764125,
    "text": "You and Wangdoo follow the signal."
  },
  {
    "at": 12.1,
    "end": 13.771083,
    "text": "Your co-pilot? Wangdoo."
  },
  {
    "at": 24.7,
    "end": 27.058875,
    "text": "His Scout Wing picks up a call for help."
  },
  {
    "at": 31.35,
    "end": 33.434,
    "text": "There's nobody behind the door."
  },
  {
    "at": 33.614,
    "end": 35.212417,
    "text": "The call for help was fake."
  },
  {
    "at": 39.0,
    "end": 41.597458,
    "text": "The missing astronaut didn't need rescuing."
  },
  {
    "at": 41.777458,
    "end": 43.054417,
    "text": "He needed your ship."
  },
  {
    "at": 56.35,
    "end": 58.325,
    "text": "Only enough power for one Wing."
  },
  {
    "at": 59.3,
    "end": 60.7365,
    "text": "Boost to catch the ship?"
  },
  {
    "at": 60.8565,
    "end": 62.449667,
    "text": "Or Shield, and stay here?"
  },
  {
    "at": 65.25,
    "end": 66.692792,
    "text": "Which Wing would you choose?"
  }
